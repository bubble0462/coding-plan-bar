{
  "name": "coding-plan-bar",
  "version": "0.8.4",
  "productName": "Coding Plan Bar",
  "description": "Windows tray quota monitor for Codex and optional coding-plan providers.",
  "main": "src/main.js",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "pack": "electron-builder --dir",
    "smoke:electron": "electron . --smoke-startup",
    "screenshot": "electron scripts/capture-popup.js",
    "screenshot:detail": "electron scripts/capture-popup.js --detail",
    "screenshot:deepseek": "electron scripts/capture-popup.js --deepseek",
    "screenshot:reorder": "electron scripts/capture-popup.js --reorder",
    "screenshot:grok": "electron scripts/capture-popup.js --grok",
    "screenshot:settings": "electron scripts/capture-settings.js",
    "screenshot:settings:templates": "electron scripts/capture-settings.js --templates",
    "screenshot:settings:reorder": "electron scripts/capture-settings.js --reorder",
    "screenshot:settings:update": "electron scripts/capture-settings.js --update",
    "screenshot:settings:import": "electron scripts/capture-settings.js --import",
    "screenshot:settings:import-source": "electron scripts/capture-settings.js --import-source",
    "screenshot:settings:import-drop": "electron scripts/capture-settings.js --import-drop",
    "screenshot:settings:import-paste": "electron scripts/capture-settings.js --import-paste",
    "screenshot:settings:import-claude": "electron scripts/capture-settings.js --import-claude",
    "screenshot:settings:dirty": "electron scripts/capture-settings.js --dirty",
    "screenshot:settings:health": "electron scripts/capture-settings.js --health",
    "screenshot:settings:backup": "electron scripts/capture-settings.js --backup",
    "release:github": "node scripts/release.js",
    "check": "node scripts/check-syntax.js && npx eslint .",
    "lint": "eslint .",
    "smoke": "node scripts/smoke-test.js",
    "screenshot:settings:usage": "electron scripts/capture-settings.js --usage",
    "screenshot:settings:notifications": "electron scripts/capture-settings.js --notifications",
    "screenshot:settings:probe": "electron scripts/capture-settings.js --probe",
    "screenshot:dark": "electron scripts/capture-popup.js --dark",
    "screenshot:settings:dark": "electron scripts/capture-settings.js --dark"
  },
  "keywords": [
    "electron",
    "windows",
    "tray",
    "codex",
    "claude",
    "coding-plan"
  ],
  "author": "",
  "license": "MIT",
  "build": {
    "appId": "com.bubble.coding-plan-bar",
    "productName": "Coding Plan Bar",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "config.example.json",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Coding Plan Bar"
    }
  },
  "devDependencies": {
    "electron": "^42.6.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8"
  }
}
